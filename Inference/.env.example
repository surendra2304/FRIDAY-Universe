# ==============================================================================
#                 INFERENCE — PRODUCTION CONFIGURATION TEMPLATE
# ==============================================================================
# Identity: Centralized LLM Gateway & Provider Fallback Router for FRIDAY Universe
# Network: friday_mesh | Domain: https://friday-universe.duckdns.org/inference

# ── Primary Provider API Key Pools (Comma-separated or singular) ───────────────
# Google Gemini
GEMINI_API_KEYS=""
GEMINI_API_KEY=""

# Groq Cloud (Ultra-low latency LPU)
GROQ_API_KEYS=""
GROQ_API_KEY=""

# Cerebras Inference (World-record token generation speed)
CEREBRAS_API_KEYS=""
CEREBRAS_API_KEY=""

# OpenRouter (Aggregated provider fallback)
OPENROUTER_API_KEYS=""
OPENROUTER_API_KEY=""

# NVIDIA NIM / Nemotron
NVIDIA_API_KEYS=""
NVIDIA_API_KEY=""

# Bytez (TASK-IG2-INF-01) — hosted serverless inference, OpenAI-compatible.
# FREE TIER ONLY: the documented $0 tier covers ≤7B open models at 1
# concurrent request and states NO recurring free allowance, so Bytez's free
# volume is UNPROVEN. The gateway rung stays OFF until the quota probe
# (python -m app.providers.bytez_probe) has measured real volume across
# repeated runs and an operator enables it. Anything beyond the $0 tier is
# credit-metered (paid) and out of bounds.
BYTEZ_API_KEYS=""
BYTEZ_API_KEY=""
INFERENCE_BYTEZ_RUNG_ENABLED=false

# OpenAI (GPT-4o, GPT-4o-mini, o1, o3-mini)
OPENAI_API_KEYS=""
OPENAI_API_KEY=""

# Mistral AI
MISTRAL_API_KEYS=""
MISTRAL_API_KEY=""

# Cohere
COHERE_API_KEYS=""
COHERE_API_KEY=""

# HuggingFace Inference API
HUGGINGFACE_API_KEYS=""
HUGGINGFACE_API_KEY=""

# ── Third-Party & Fallback Pools ───────────────────────────────────────────────
THIRD_PARTY_GEMINI_KEYS=""
THIRD_PARTY_GEMINI_KEY=""
GEMINI_FALLBACK_KEYS=""
GEMINI_FALLBACK_KEY=""

THIRD_PARTY_GROQ_KEYS=""
THIRD_PARTY_GROQ_KEY=""
GROQ_FALLBACK_KEYS=""
GROQ_FALLBACK_KEY=""

THIRD_PARTY_OPENROUTER_KEYS=""
THIRD_PARTY_OPENROUTER_KEY=""
OPENROUTER_FALLBACK_KEYS=""
OPENROUTER_FALLBACK_KEY=""

THIRD_PARTY_OPENAI_KEYS=""
THIRD_PARTY_OPENAI_KEY=""
OPENAI_FALLBACK_KEYS=""
OPENAI_FALLBACK_KEY=""

THIRD_PARTY_NVIDIA_KEYS=""
THIRD_PARTY_NVIDIA_KEY=""

# ── Security & Authentication ──────────────────────────────────────────────────
# Encrypted key vault (TASK-IG2-INF-02, FreeLLMAPI pattern): provider keys may
# be stored encrypted at rest instead of as plaintext above. The master key
# lives ONLY in the service environment — never in the vault file, never in
# the repo. When both are set, the gateway fills still-empty key fields from
# the vault at startup; real environment values always win, and each vault
# entry fills only its own field (pools are never merged). Manage entries
# with: python -m app.providers.key_vault {set|list|verify|delete}
INFERENCE_KEY_VAULT_MASTER_KEY=""
INFERENCE_KEY_VAULT_FILE=""

# Required for all model execution and state routes (set a strong random secret)
INFERENCE_API_KEY=""
FRIDAY_API_KEY=""
FRIDAY_UNIVERSE_API_KEY=""
X_FRIDAY_API_KEY=""

# ── Server & Gateway Runtime Configuration ────────────────────────────────────
APP_NAME="Inference"
APP_ENV="production"
HOST="0.0.0.0"
PORT=8000
INFERENCE_URL="https://friday-universe.duckdns.org/inference"
# Oracle Autonomous Database only. PostgreSQL/SQLite are not supported.
# Inference login/schema on the FRIDAY Universe DB; credentials are read at runtime.
DATABASE_URL="oracle+oracledb://INFERENCE:password@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.REGION.oraclecloud.com))(connect_data=(service_name=SERVICE_NAME))(security=(ssl_server_dn_match=yes)))"

# ── Token Compression (TASK-IG2-INF-04, OmniRoute pattern) ───────────────────
# Rule-based compression of outbound prompts (strip redundant whitespace,
# dedupe repeated context blocks/messages; fenced code is never touched).
# Short prompts bypass below INFERENCE_COMPRESSION_MIN_TOKENS estimated
# tokens. Set ENABLED=false to disable the stage entirely.
INFERENCE_TOKEN_COMPRESSION_ENABLED=true
INFERENCE_COMPRESSION_MIN_TOKENS=800

# ── Needle Fast Path (TASK-INF-038, cactus-compute Needle) ──────────────────
# Optional pre-routing stage in ModelGateway: when enabled, a single user
# command routed by the local Needle engine to a fixed FRIDAY device-safe
# tool (weather / reminder / memory search) answers with the tool call and
# spends no cloud round trip. Anything else falls through to the provider
# ladder. Requires the cactus package on the device that runs the fast path
# (pip install cactus-compute); off by default until the device admission
# gate (IG-INF-04 §6) passes on the actual device.
NEEDLE_FAST_PATH_ENABLED=false
NEEDLE_ENGINE=cactus

# ── Concurrency & Memory Guard ────────────────────────────────────────────────
WEB_CONCURRENCY=1
MEMORY_TRIM_ENABLED=true
MEMORY_TRIM_THRESHOLD_MB=400.0
MEMORY_TRIM_COOLDOWN_SECONDS=60.0

# ── Self-Hosted / Local LLM Tier (Optional) ───────────────────────────────────
LOCAL_ENABLED=false
LOCAL_BASE_URL="http://127.0.0.1:11434/v1"
LOCAL_MODEL="local-model"
LOCAL_PREFERRED=false

# --- AGENT 10 VYRALX MESH ---
VYRALX_URL=http://vyralx:8000
VYRALX_API_KEY=

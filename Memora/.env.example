# ==============================================================================
#                     MEMORA PRODUCTION CONFIGURATION
# ==============================================================================

# Core Application Settings
MEMORA_ENV=production
# Generic env flags — MUST agree with MEMORA_ENV (TASK-REL-047, decided in
# TASK-REL-045's tuning table). Memora's auth production check reads
# MEMORA_ENV *or* ENVIRONMENT (apps/api/dependencies.py), and several
# storage/event paths read ENVIRONMENT or APP_ENV directly, so a deployment
# whose generic flags say "development" while MEMORA_ENV says "production"
# is a latent fail-open surface. All three flags ship as "production" here;
# the deployed .env on Server 1 is flipped to match (see
# docs/verification/ENV_FLAG_FLIP_REL047.md for the deploy steps and the
# post-flip MEM-005 auth-matrix re-run).
ENVIRONMENT=production
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Authoritative production relational storage: Oracle Autonomous Database.
# Oracle Autonomous Database only. PostgreSQL/SQLite are not supported.
# Use the MEMORA login/schema; never reuse another agent's credentials.
DATABASE_URL=oracle+oracledb://MEMORA:password@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.REGION.oraclecloud.com))(connect_data=(service_name=SERVICE_NAME))(security=(ssl_server_dn_match=yes)))
MEMORA_DB_POOL_SIZE=3
MEMORA_DB_MAX_OVERFLOW=2
DB_ECHO=false

# Distributed Cache & Event Bus (Redis)
REDIS_URL=redis://redis:6379/0

# Vector Database (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=memora_embeddings
# Embeddings are currently fixed at 384 dimensions. The Qdrant collection,
# when used, must be provisioned with the same dimension; Memora does not
# create or resize that collection automatically.

# Security & Master API Key (TASK-MEM-005-R1 credential model)
# MEMORA_API_KEY is the memora identity's OWN per-agent key — nothing more.
# It lives ONLY in this env file. Never copy it into another agent's env:
# until MEM-005-R1 it doubled as the fleet master key, and a copy sat in
# every agent's .env (audit finding F1).
MEMORA_API_KEY=
# MEMORA_MASTER_KEY is the distinct break-glass master: a credential equal
# to it authenticates as any claimed X-Agent-Name. It must be a DIFFERENT
# value from MEMORA_API_KEY, lives ONLY in this env file (plus coordinator
# custody), and must never appear in any other agent's env. If it is unset
# the master branch is inert (fail-closed).
MEMORA_MASTER_KEY=
# Scoped delegation policy (TASK-MEM-005-R1): a caller authenticated with
# its OWN per-agent key may act for a target agent via the X-On-Behalf-Of
# header only where a grant names the (caller, target, scope) triple.
# Scopes: read, learn, write, mutate, events — derived from the route;
# anything unlisted is denied. Unset = no delegation anywhere.
# Recommended grants (FRIDAY's audited uses: cross-agent recall +
# write-outcome-for-X):
# MEMORA_DELEGATIONS=friday>stratex:read,learn;friday>intelx:read,learn;friday>futuris:read,learn;friday>forge:read,learn;friday>sentinel:read,learn;friday>cortex:read,learn;friday>vyralx:read,learn;friday>inference:read,learn
MEMORA_DELEGATIONS=

# CORS Whitelist (Comma-separated allowed browser origins)
MEMORA_CORS_ORIGINS=https://friday-universe.duckdns.org,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8006,http://localhost:8007,http://127.0.0.1:8007,http://localhost:3000

# Peer Specialist Agent API Keys (FRIDAY Universe Mesh) — Memora's registry.
# TASK-MEM-005-R1: these values are DEDICATED Memora-only credentials. Each
# value lives in exactly one other place: the owning agent's own env, under
# the name <AGENT>_MEMORA_API_KEY (e.g. VyralX's env holds
# VYRALX_MEMORA_API_KEY with the same value as VYRALX_API_KEY below).
# They are NOT the agents' service keys — never reuse a value that also
# authenticates to another agent's own API, and never copy MEMORA_API_KEY
# itself into an agent deployment.
VYRALX_API_KEY=
FRIDAY_API_KEY=
INFERENCE_API_KEY=
STRATEX_API_KEY=
INTELX_API_KEY=
FUTURIS_API_KEY=
CORTEX_API_KEY=
FORGE_API_KEY=
SENTINEL_API_KEY=

# Policy & Retention Thresholds
DEFAULT_CONFIDENCE_THRESHOLD=0.75
DEFAULT_IMPORTANCE_THRESHOLD=0.50

# Resilience & Circuit Breakers (friday_mesh peer protection)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30.0
HTTP_CLIENT_TIMEOUT_SECONDS=10.0

# In-Memory Cache (Tenant-Isolated LRU / TTL)
MEMORY_CACHE_TTL_SECONDS=300.0
MEMORY_CACHE_MAX_CAPACITY=2000

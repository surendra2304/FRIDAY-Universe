[Unit]
Description=Oracle Cloud 24/7 Full-Access Agent Server for ChatGPT
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/oracle_mcp
ExecStart=/usr/bin/python3 /opt/oracle_mcp/server.py
Restart=always
RestartSec=5
# Keep the token outside the repository, readable only by root:
#   install -m 600 /dev/null /etc/oracle-mcp.env
#   echo "ORACLE_MCP_TOKEN=<64-hex-secret>" > /etc/oracle-mcp.env
EnvironmentFile=/etc/oracle-mcp.env

[Install]
WantedBy=multi-user.target

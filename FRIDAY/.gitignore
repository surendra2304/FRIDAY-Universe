# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Python build artifacts (gitignore.io template).
# NOTE (checklist D12 fix, 2026-11-11): the bare `lib/` rule silently hid the
# Next.js UI source directory FRIDAY/ui/lib/ — which is why lib/api.ts was
# never committed even though app/page.tsx imports it and the deploy bundle
# was built against it (the source tree could not rebuild). Python-style lib/
# build dirs stay ignored; UI TypeScript source under ui/lib/ is tracked.
lib/
!ui/lib/
!ui/lib/**
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
ENV/
env/

# Environment Variables & Secrets
.env
.env.production
.env.local
.env.*.local
*.key
*.pem

# Logs
logs/
*.log

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo

# Testing & Coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/


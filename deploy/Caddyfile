# TASK-VAL-006: mirrors the deployed /etc/caddy/Caddyfile on Server 1 (verified
# live 2026-11-22 ~23:45 IST). Keep in sync with the deployed file: S1 =
# FRIDAY/Inference/Memora/Forge/Sentinel (+ Stratex SSH tunnel), S2 =
# Futuris/IntelX/Cortex/Bridge, AWS U1 = Stratex, AWS = VyralX.
friday-universe.duckdns.org {
    log {
        output file /var/log/caddy/friday-access.log {
            roll_size 10mb
            roll_keep 5
            roll_keep_for 168h
        }
        format json
    }
    handle_path /friday/api/ws/activity {
        reverse_proxy 127.0.0.1:10000 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
            header_up Connection "Upgrade"
            header_up Upgrade "websocket"
        }
    }
    handle_path /friday* {
        reverse_proxy 127.0.0.1:10000 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle_path /inference* {
        reverse_proxy 127.0.0.1:8001 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle_path /memora* {
        reverse_proxy 127.0.0.1:8002 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle_path /stratex* {
        reverse_proxy 127.0.0.1:18003 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    # TASK-IG2-WEB-04-FIX-01: the Stratex dashboard (served under
    # /stratex/) used to reference its assets and API root-relative, so
    # they 404'd / served the FRIDAY SPA at the site root (WEB-006).
    # The dashboard now references them mount-relative, but the root
    # paths must answer 200 too: the FRIDAY app owns no /static/* path
    # (its Next.js assets live under /friday/_next/static/), and
    # /api/v1/market/sector-heatmap is Stratex-only, so these two
    # handles cannot shadow FRIDAY. `handle` (not `handle_path`) so the
    # full path reaches the Stratex app, whose Flask static route and
    # sector-heatmap blueprint serve them. /api/* as a whole stays with
    # FRIDAY — the dashboard's other API calls go via /stratex/api/*.
    handle /static/* {
        reverse_proxy 127.0.0.1:18003 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle /api/v1/market/sector-heatmap {
        reverse_proxy 127.0.0.1:18003 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle_path /futuris* {
        reverse_proxy 10.0.0.120:8004 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle_path /intelx* {
        reverse_proxy 10.0.0.120:8005 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle_path /forge* {
        reverse_proxy 127.0.0.1:8006 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle_path /bridge* {
        reverse_proxy 10.0.0.120:8011 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle_path /mcp* {
        reverse_proxy 10.0.0.120:8011 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle_path /messages* {
        reverse_proxy 10.0.0.120:8011 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle_path /vyralx* {
        reverse_proxy 16.176.9.247:8010 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle_path /sentinel* {
        reverse_proxy 127.0.0.1:8008 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle_path /cortex* {
        reverse_proxy 10.0.0.120:8009 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle /privacy-vyralx {
        root * /srv/friday-static
        rewrite * /vyralx-privacy-policy.html
        file_server
    }
    handle /pepperstone-auth {
        root * /srv/friday-static
        rewrite * /pepperstone-auth.html
        file_server
    }
    # TASK-WEB-005-FIX-01: the Halo stage's own route. The app is a
    # static export with basePath /friday, so the route's file is
    # out/halo/index.html and the FRIDAY service answers it at
    # /friday/halo/; this handle exposes it at the bare-domain /halo
    # the acceptance names. The rewrite (not a redirect) keeps the
    # /halo URL in the browser; the page's assets are /friday/_next/…
    # and already pass through the /friday* handle above. Port to the
    # Server 2 live file with its upstream (15.134.130.145:10000).
    handle /halo* {
        rewrite * /friday/halo/
        reverse_proxy 127.0.0.1:10000 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    handle {
        reverse_proxy 127.0.0.1:10000 {
            transport http {
                keepalive 180s
                keepalive_idle_conns 50
            }
        }
    }
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }
}

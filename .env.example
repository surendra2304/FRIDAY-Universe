# FRIDAY Universe — Environment Variables
# Copy this file to .env and fill in your values
# All secrets are loaded via os.getenv() — never hardcode in source

# ── Email (Gmail SMTP) ──
FRIDAY_EMAIL_APP_PASSWORD=your_gmail_app_password

# ── API Keys ──
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=

# ── Trading (Binance Futures) ──
STRATEX_BINANCE_API_KEY=
STRATEX_BINANCE_API_SECRET=

# ── Database (Oracle Autonomous Database only) ──
# One unprivileged login per agent. Never commit a real value.
DATABASE_URL=oracle+oracledb://USER:PASSWORD@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.<region>.oraclecloud.com))(connect_data=(service_name=<service>_medium.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# ── Logging ──
FRIDAY_LOG_LEVEL=INFO

# ── Server ──
FRIDAY_HOST=0.0.0.0
FRIDAY_PORT=8000
